{
  "name": "cdtn2-nhom03",
  "version": "1.0.0",
  "description": "Nền tảng kết nối và đặt dịch vụ sửa chữa tại nhà - Nhóm 03",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node --watch src/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "migrate": "node src/migrate.js",
    "seed": "node seeds/chay-seed.js",
    "seed:reset": "node seeds/chay-seed.js --reset",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "frontend": "npm run dev:frontend",
    "frontend:build": "npm --prefix frontend run build",
    "create-admin": "node src/tao-quan-tri-vien.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
