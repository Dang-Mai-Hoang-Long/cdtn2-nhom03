### PATCH /api/requests/{id}
# Chỉ chủ tin, khi chưa chọn kỹ thuật viên (409 REQUEST_NOT_EDITABLE nếu đã chọn).
# @name suaTin
PATCH {{baseUrl}}/requests/{{taoTin.response.body.$.data.id}}
Content-Type: {{json}}
Authorization: Bearer {{dnKhach.response.body.$.data.token}}

{
  "title": "Máy lạnh không làm mát (đã sửa)"
}

# Phản hồi thật đã lưu: HTTP 200
#   {
#     "success": true,
#     "data": {
#       "id": 1054,
#       "customerId": 2,
#       "title": "Máy lạnh không làm mát (đã sửa)",
#       "description": "Máy chạy nhưng gió không lạnh từ hôm qua.",
#       "category": "Sửa máy lạnh",
#       "location": "Quận 3, TP. Hồ Chí Minh",
#       "preferredTime": "2026-11-28T10:21:22.537Z",
#       "status": "WAITING_PROPOSAL",
#       "selectedProposalId": null,
#       "createdAt": "2026-11-26T10:21:22.539Z"
#     },
#     "message": "Chỉnh sửa tin thành công"
#   }

### POST /api/proposals
# Chỉ kỹ thuật viên; mỗi người một đề xuất hiệu lực cho một tin (409 ALREADY_PROPOSED).
# @name guiDeXuat
POST {{baseUrl}}/proposals
Content-Type: {{json}}
Authorization: Bearer {{dnKtv.response.body.$.data.token}}

{
  "requestId": {{taoTin.response.body.$.data.id}},
  "price": 450000,
  "description": "Kiểm tra gas, vệ sinh dàn lạnh, thay ống thoát nước.",
  "estimatedDuration": "2-3 giờ"
}

# Phản hồi thật đã lưu: HTTP 201
#   {
#     "success": true,
#     "data": {
#       "id": 2193,
#       "requestId": 1054,
#       "technicianId": 4,
#       "price": 450000,
#       "description": "Kiểm tra gas, vệ sinh dàn lạnh, thay ống thoát nước.",
#       "estimatedDuration": "2-3 giờ",
#       "status": "PENDING",
#       "createdAt": "2026-11-26T10:21:22.580Z"
#     },
#     "message": "Gửi đề xuất thành công"
#   }

