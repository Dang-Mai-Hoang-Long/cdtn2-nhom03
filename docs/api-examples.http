### A07: token đã hết hạn (ký đúng khóa)
# Tạo token rồi dán vào biến @tokenHetHan ở đầu tệp: node -e "console.log(require('jsonwebtoken').sign({userId:2,role:'CUSTOMER'}, process.env.JWT_SECRET, {expiresIn:-10}))" . Mong đợi 401.
# @name bm_a07_het
GET {{baseUrl}}/auth/me
Content-Type: {{json}}
Authorization: Bearer {{tokenHetHan}}

# Phản hồi thật đã lưu: HTTP 401
#   {
#     "success": false,
#     "status": 401,
#     "error": "Unauthorized",
#     "message": "Phiên đăng nhập không hợp lệ hoặc đã hết hạn",
#     "code": "UNAUTHORIZED",
#     "timestamp": "2026-11-26T10:21:22.750Z",
#     "path": "/api/auth/me"
#   }

### A07: token HS512 ký đúng khóa (hệ thống ghim HS256)
# Tạo token rồi dán vào biến @tokenHS512 ở đầu tệp: node -e "console.log(require('jsonwebtoken').sign({userId:2,role:'CUSTOMER'}, process.env.JWT_SECRET, {algorithm:'HS512'}))" . Mong đợi 401.
# @name bm_a07_hs512
GET {{baseUrl}}/auth/me
Content-Type: {{json}}
Authorization: Bearer {{tokenHS512}}

# Phản hồi thật đã lưu: HTTP 401
#   {
#     "success": false,
#     "status": 401,
#     "error": "Unauthorized",
#     "message": "Phiên đăng nhập không hợp lệ hoặc đã hết hạn",
#     "code": "UNAUTHORIZED",
#     "timestamp": "2026-11-26T10:21:22.751Z",
#     "path": "/api/auth/me"
#   }

### A07: token đặt trong URL (?token=...)
# Mong đợi 401: chỉ nhận token qua tiêu đề Authorization.
# @name bm_a07_url
GET {{baseUrl}}/auth/me?token={{dnKhach.response.body.$.data.token}}
Content-Type: {{json}}

# Phản hồi thật đã lưu: HTTP 401
#   {
#     "success": false,
#     "status": 401,
#     "error": "Unauthorized",
#     "message": "Bạn cần đăng nhập để tiếp tục",
#     "code": "UNAUTHORIZED",
#     "timestamp": "2026-11-26T10:21:22.753Z",
#     "path": "/api/auth/me"
#   }

