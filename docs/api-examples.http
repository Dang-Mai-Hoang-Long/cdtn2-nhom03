### A02: đường dẫn không tồn tại
# @name bm_a02_404
GET {{baseUrl}}/duong-dan-khong-ton-tai
Content-Type: {{json}}

# Phản hồi thật đã lưu: HTTP 404
#   {
#     "success": false,
#     "status": 404,
#     "error": "Not Found",
#     "message": "Không tìm thấy đường dẫn",
#     "code": "NOT_FOUND",
#     "timestamp": "2026-11-26T10:21:22.731Z",
#     "path": "/api/duong-dan-khong-ton-tai"
#   }

### A02: CORS từ nguồn lạ
# Mong đợi Access-Control-Allow-Origin là địa chỉ giao diện đã cấu hình (không phản chiếu nguồn lạ, không phải *) và KHÔNG có X-Powered-By.
# @name bm_a02_cors
GET {{baseUrl}}/health
Content-Type: {{json}}
Origin: http://evil.example

# Phản hồi thật đã lưu: HTTP 200
#   (tiêu đề) access-control-allow-origin: http://localhost:5173
#   (tiêu đề) x-powered-by: (không có)
#   {
#     "success": true,
#     "data": {
#       "status": "ok"
#     },
#     "message": "Thành công"
#   }

### A05: chuỗi ' OR 1=1 -- ở bộ lọc
# Mong đợi 200 với 0 bản ghi (chuỗi được coi là chữ thường), không trả toàn bộ tin.
# @name bm_a05_loc
GET {{baseUrl}}/requests?category=%27%20OR%201%3D1%20--&size=1
Content-Type: {{json}}
Authorization: Bearer {{dnKtv.response.body.$.data.token}}

# Phản hồi thật đã lưu: HTTP 200
#   {
#     "success": true,
#     "data": [],
#     "message": "Thành công",
#     "meta": {
#       "page": 1,
#       "size": 1,
#       "totalElements": 0,
#       "totalPages": 0
#     }
#   }

### A05: tiêm SQL vào ô email đăng nhập
# Mong đợi 401, không có token.
# @name bm_a05_dn
POST {{baseUrl}}/auth/login
Content-Type: {{json}}

{
  "email": "admin@demo.vn' OR '1'='1",
  "password": "x' OR '1'='1"
}

# Phản hồi thật đã lưu: HTTP 401
#   {
#     "success": false,
#     "status": 401,
#     "error": "Unauthorized",
#     "message": "Email hoặc mật khẩu không đúng",
#     "code": "UNAUTHORIZED",
#     "timestamp": "2026-11-26T10:21:22.739Z",
#     "path": "/api/auth/login"
#   }

### A05: đăng tin chứa thẻ script
# Mong đợi 201, lưu nguyên văn; giao diện hiển thị thành chữ (xem báo cáo, mục "Giao diện trên trình duyệt").
# @name bm_a05_xss
POST {{baseUrl}}/requests
Content-Type: {{json}}
Authorization: Bearer {{dnKhach.response.body.$.data.token}}

{
  "title": "Thử XSS <script>alert(1)</script>",
  "description": "<img src=x onerror=alert(2)>",
  "category": "Khác",
  "location": "Quận 1",
  "preferredTime": "{{$datetime iso8601 2 d}}"
}

# Phản hồi thật đã lưu: HTTP 201
#   {
#     "success": true,
#     "data": {
#       "id": 1057,
#       "customerId": 2,
#       "title": "Thử XSS <script>alert(1)</script>",
#       "description": "<img src=x onerror=alert(2)>",
#       "category": "Khác",
#       "location": "Quận 1",
#       "preferredTime": "2026-11-28T10:21:22.739Z",
#       "status": "WAITING_PROPOSAL",
#       "selectedProposalId": null,
#       "createdAt": "2026-11-26T10:21:22.741Z"
#     },
#     "message": "Tạo tin thành công"
#   }

