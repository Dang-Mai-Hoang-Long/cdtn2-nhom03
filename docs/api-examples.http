### PATCH /api/requests/{id}/close
# Chỉ chủ tin, khi tin chưa chọn kỹ thuật viên.
# @name dongTin
PATCH {{baseUrl}}/requests/{{taoTin2.response.body.$.data.id}}/close
Content-Type: {{json}}
Authorization: Bearer {{dnKhach.response.body.$.data.token}}

# Phản hồi thật đã lưu: HTTP 200
#   {
#     "success": true,
#     "data": {
#       "id": 1055,
#       "customerId": 2,
#       "title": "Vòi nước bếp rò rỉ",
#       "description": "Nhỏ giọt cả ngày.",
#       "category": "Sửa ống nước",
#       "location": "Quận 7, TP. Hồ Chí Minh",
#       "preferredTime": "2026-11-29T10:21:22.555Z",
#       "status": "CLOSED",
#       "selectedProposalId": null,
#       "createdAt": "2026-11-26T10:21:22.557Z"
#     },
#     "message": "Đóng tin thành công"
