### GET /api/requests/my
# Phân trang: page từ 1, size mặc định 10 (tối đa 100), sort=createdAt,asc để cũ nhất trước.
# @name tinCuaToi
GET {{baseUrl}}/requests/my?size=2
Content-Type: {{json}}
Authorization: Bearer {{dnKhach.response.body.$.data.token}}

# Phản hồi thật đã lưu: HTTP 200
#   {
#     "success": true,
#     "data": [
#       {
#         "id": 1055,
#         "customerId": 2,
#         "title": "Vòi nước bếp rò rỉ",
#         "description": "Nhỏ giọt cả ngày.",
#         "category": "Sửa ống nước",
#         "location": "Quận 7, TP. Hồ Chí Minh",
#         "preferredTime": "2026-11-29T10:21:22.555Z",
#         "status": "WAITING_PROPOSAL",
#         "selectedProposalId": null,
#         "createdAt": "2026-11-26T10:21:22.557Z",
#         "proposalCount": 0
#       },
#       "… (1 phần tử nữa, rút gọn)"
#     ],
#     "message": "Thành công",
#     "meta": {
#       "page": 1,
#       "size": 2,
#       "totalElements": 16,
#       "totalPages": 8
#     }
#   }

