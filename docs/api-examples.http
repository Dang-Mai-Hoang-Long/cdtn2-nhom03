GET {{baseUrl}}/admin/users
Content-Type: {{json}}
Authorization: Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJ1c2VySWQiOjEsInJvbGUiOiJBRE1JTiJ9.

