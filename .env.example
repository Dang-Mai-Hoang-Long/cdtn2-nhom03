# Mẫu chạy được ngay trên máy cá nhân: sao chép thành .env (cp .env.example .env) rồi chạy.
# Mọi giá trị dưới đây CHỈ dành cho phát triển và chấm bài trên máy cá nhân. Khi triển khai thật phải đổi hết
# (xem docs/deployment-guide.md): mật khẩu CSDL mới, JWT_SECRET ngẫu nhiên mới, NODE_ENV=production.

# Cổng chạy backend
PORT=3000
# Chuỗi kết nối PostgreSQL 16 (chạy bằng cài tay; cổng 5432). Chạy bằng docker compose thì api tự dùng DB_PASSWORD bên dưới.
DATABASE_URL=postgres://nhom03:nhom03@localhost:5432/suachua_dev
# Cơ sở dữ liệu riêng cho kiểm thử (sẽ bị xóa và tạo lại khi chạy npm test)
TEST_DATABASE_URL=postgres://nhom03:nhom03@localhost:5432/suachua_test
# Khóa ký JWT, ít nhất 32 ký tự (backend từ chối khởi động nếu ngắn hơn). Giá trị mẫu này KHÔNG dùng khi triển khai thật.
# Tạo khóa mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=khoa-mau-chi-de-phat-trien-doi-truoc-khi-trien-khai-0123456789
JWT_EXPIRES_IN=1d
# Địa chỉ frontend (Vite) được phép gọi API
CLIENT_URL=http://localhost:5173

# Chỉ dùng khi chạy bằng docker compose
# Mật khẩu của user nhom03 trong CSDL chạy bằng Docker (đặt khi volume CSDL được tạo lần đầu; chỉ dùng chữ và số vì được ghép vào chuỗi kết nối)
DB_PASSWORD=nhom03
# Cổng CSDL mở ra máy chủ (tránh đụng PostgreSQL cài sẵn ở 5432)
DB_PORT=5433
